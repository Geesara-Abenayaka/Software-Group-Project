# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/POST_GRADUATE_LMS_DB
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=cluster0.mgyo1zg.mongodb.net
DB_NAME=POST_GRADUATE_LMS_DB
PORT=5000

# Hosted frontend origin(s), comma-separated if needed
CORS_ORIGIN=https://your-frontend-domain.com

# SendGrid (required for real email delivery)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=admissions@uom.lk
SENDGRID_FROM_NAME=University of Moratuwa PG Admissions
SENDGRID_REPLY_TO=admissions@uom.lk

# Optional: Gemini Vision OCR for image extraction (recommended)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_VISION_MODEL=gemini-1.5-flash

# Course Advisor chatbot (uses GEMINI_API_KEY above).
# Set to a current Flash model from Google AI Studio's model list. Without it the chat uses its offline answers.
GEMINI_CHAT_MODEL=

# Optional for local testing without delivering real emails.
# Set to true only if you intentionally want simulation mode.
EMAIL_SIMULATION=false

# Stripe: card payment of the Rs. 2,000 application fee on the application form.
# Keys from https://dashboard.stripe.com/apikeys (sk_test_/pk_test_ while testing, sk_live_/pk_live_ for real payments).
# The publishable key is sent to the browser when a payment starts; the secret key never leaves the server.
# Leave both empty to hide card payment (applicants then upload a bank receipt).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
